{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push)",
      "Bash(git push origin main)",
      "Bash(git push origin HEAD)",
      "Bash(git pull:*)",
      "Bash(luacheck:*)",
      "Bash(stylua:*)",
      "Bash(ls:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__NVIM_CONFIG__/docs/NOTES/CDX/check-hook.js\""
          }
        ]
      }
    ]
  }
}
