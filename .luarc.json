{
    "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
    "runtime.version": "LuaJIT",
    "runtime.path": [
        "lua/?.lua",
        "lua/?/init.lua",
        "tests/?.lua"
    ],
    "completion.callSnippet": "Replace",
    "hint": {
     "enable": true,
     "arrayIndex": true,
     "await": true,
     "awaitPropagate": true,
     "paramName": "All",
     "paramType": true,
     "semicolon": "All",
     "setType": true,
    },
    "type": {
        "checkTableShape": true,
        "inferParamType": true,
    },
    "type.castNumberToInteger": true,
    "diagnostics.libraryFiles": "Disable",
    "diagnostics.unusedLocalExclude": ["_*"],
    "diagnostics.globals": [
        "assert",
        "after_each",
        "before_each",
        "describe",
        "it",
        "neq",
        "mock",
        "pending",
        "setup",
        "spy",
        "stub",
        "teardown",
        "vim"
    ],
    "workspace.useGitIgnore": true,
    "workspace.checkThirdParty": false,
    "workspace.ignoreDir": [
        ".claude",
        "**/.claude",
        ".dependencies",
        ".git",
        ".luarocks",
        ".lua",
        ".neotest",
        "build",
        "dist",
        "docs",
        "github-stats",
        "node_modules",
        "vendor"
    ],
    "files.exclude": [
        "**/.git/**",
        "**/node_modules/**",
        "**/dist/**",
        "**/build/**",
        "**/docs/**",
        "**/plugins/github-stats/**"
    ]
}

