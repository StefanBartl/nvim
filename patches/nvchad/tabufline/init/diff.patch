   local bufs = vim.t.bufs
   local curbufIndex = buf_index(cur_buf())
 
   if not curbufIndex then
     set_buf(vim.t.bufs[1])
     return
   end
 
   set_buf((curbufIndex == #bufs and bufs[1]) or bufs[curbufIndex + 1])
 end
 
