+---Find index of buffer in tab-local buffer list
+---@param bufnr number Buffer number to find
+---@return number|nil Index of buffer or nil if not found
 local function buf_index(bufnr)
   for i, value in ipairs(vim.t.bufs) do
     if value == bufnr then
       return i
     end
   end
 end
 
+---Switch to next buffer in list
+---@return nil
