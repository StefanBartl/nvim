+---Close tab and all of its buffers
+---@param include_cur_buf boolean|nil Whether to include current buffer
+---@return nil
 M.closeAllBufs = function(include_cur_buf)
   local bufs = vim.t.bufs
 
   if include_cur_buf ~= nil and not include_cur_buf then
     table.remove(bufs, buf_index(cur_buf()))
   end
 
   for _, buf in ipairs(bufs) do
     M.close_buffer(buf)
   end
 end
 
